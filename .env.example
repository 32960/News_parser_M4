# PostgreSQL (used by docker-compose postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ainews

# App / workers
# Local (API/Celery on host, Postgres in Docker with published port):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ainews
#
# Docker Compose (containers talk to service name "postgres"):
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ainews
#
# If the password has special characters (! @ # %), URL-encode them
# (e.g. "!" → "%21") or avoid such characters in the password.

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Inside docker-compose broker URLs are overridden to redis://redis:6379/...

# Telegram (https://my.telegram.org)
# Session file path relative to project root (shared with containers via volume)
TELEGRAM_SESSION_PATH=telegram_sessions/session
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Where generated posts are published (@username or numeric channel id -100...)
TELEGRAM_TARGET_CHANNEL=@your_channel

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
